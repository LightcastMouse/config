# Ignore everything by default.
*

# Keep the ignore rules themselves.
!/.gitignore

# Allow traversal into whitelisted directories.
!/ghostty/
!/lazygit/
!/zed/
!/zed/snippets/

# Whitelisted config files.
!/ghostty/config.ghostty
!/lazygit/config.yml
!/zed/keymap.json
!/zed/settings.json
!/zed/snippets/snippets.json

# directory to put whitelisted stuff
!/white/
!/white/*
