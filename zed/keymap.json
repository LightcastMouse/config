[
  {
    "bindings": {
      "cmd-1": ["pane::ActivateItem", 0],
      "cmd-2": ["pane::ActivateItem", 1],
      "cmd-3": ["pane::ActivateItem", 2],
      "cmd-4": ["pane::ActivateItem", 3],
      "cmd-5": ["pane::ActivateItem", 4],
      "cmd-6": ["pane::ActivateItem", 5],
      "cmd-7": ["pane::ActivateItem", 6],
      "cmd-8": ["pane::ActivateItem", 7],
      "cmd-9": ["pane::ActivateItem", 8],
      "cmd-[": "pane::GoBack",
      "cmd-]": "pane::GoForward",
      "cmd-alt-f": "editor::Format",
      "cmd-ctrl-c": "workspace::CopyPath",
      "cmd-;": "editor::ToggleInlayHints",
      "cmd-r": "editor::SelectAllMatches",
      "alt-cmd-n": "project_panel::NewDirectory",
      "shift-cmd-g": "git_panel::ToggleFocus",
      "cmd-shift-r": "workspace::ToggleRightDock",
      "cmd-shift-l": [
        "task::Spawn",
        { "task_name": "LazyGit", "reveal_target": "center" },
      ],
    },
  },
  {
    "context": "(Editor && mode == full)",
    "bindings": {
      "cmd-g": "go_to_line::Toggle",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-d": "editor::GoToDefinition",
    },
  },
  {
    "bindings": {
      "cmd-k cmd-i": "editor::ToggleFoldAll",
    },
  },
  {
    "bindings": {
      "cmd-shift-c": "editor::CopyRelativePath"
    }
  },
  {
    "bindings": {
      "cmd-shift-c": "editor::CopyRelativePath"
    }
  }
]
